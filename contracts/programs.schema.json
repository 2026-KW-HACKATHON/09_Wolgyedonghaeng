    "Program": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[CSN]\\d{2}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "in_kind",
            "grant",
            "loan",
            "service",
            "reference"
          ],
