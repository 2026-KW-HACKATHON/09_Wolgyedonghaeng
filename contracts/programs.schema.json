      "required": [
        "id",
        "name",
        "kind",
        "group",
        "region",
        "problemTypes",
        "priority",
        "apply",
        "eligibility",
        "toConfirm",
        "amount",
        "display",
        "verificationNotes",
        "dataConfidence"
