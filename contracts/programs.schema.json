          "type": "string"
        },
        "group": {
          "enum": [
            "main",
            "checkup",
            "reference"
          ],
          "title": "Group",
          "type": "string"
        },
        "region": {
          "$ref": "#/$defs/Region"
        },
        "problemTypes": {
          "items": {
            "enum": [
              "leak",
              "mold",
              "window_insulation",
              "heating",
              "plumbing",
              "safety",
              "electric",
              "other"
