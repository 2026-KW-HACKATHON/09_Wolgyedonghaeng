        "traitBonus": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "propertyNames": {
                "enum": [
                  "elderly65",
                  "disabled",
                  "welfare"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traitbonus"
        },
        "callPhone": {
          "anyOf": [
            {
              "$ref": "#/$defs/CallPhone"
            },
            {
              "type": "null"
            }
