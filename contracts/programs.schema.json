    "source": {
      "title": "Source",
      "type": "string"
    },
    "fallbackPhone": {
      "$ref": "#/$defs/CallPhone"
    },
    "programs": {
      "items": {
        "$ref": "#/$defs/Program"
      },
      "minItems": 1,
      "title": "Programs",
      "type": "array"
    }
