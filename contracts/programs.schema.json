        "dataNote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Datanote"
        },
        "dataConfidence": {
          "enum": [
            "high",
            "mid",
            "low"
          ],
          "title": "Dataconfidence",
          "type": "string"
        }
