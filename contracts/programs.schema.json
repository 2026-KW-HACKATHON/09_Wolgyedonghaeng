    "asOf": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "title": "Asof",
      "type": "string"
    },
    "builtAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Builtat"
