    "Amount": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "short": {
          "title": "Short",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "short",
        "detail"
      ],
      "title": "Amount",
      "type": "object"
    },
    "Apply": {
      "additionalProperties": false,
      "properties": {
        "state": {
